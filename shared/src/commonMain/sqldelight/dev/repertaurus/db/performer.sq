-- performer — mutable record, derived id (decisions 24, 25).
-- A new band member costs zero schema change and zero free text.

CREATE TABLE performer (
    id          TEXT NOT NULL PRIMARY KEY,
    name        TEXT NOT NULL,
    notes       TEXT,

    updated_at  TEXT NOT NULL,
    deleted_at  TEXT,
    device_id   TEXT NOT NULL,

    CHECK (updated_at GLOB '????-??-??T??:??:??.???Z'),
    CHECK (deleted_at IS NULL OR deleted_at GLOB '????-??-??T??:??:??.???Z')
);

CREATE INDEX performer_name ON performer(name);

selectAllLive:
SELECT *
FROM performer
WHERE deleted_at IS NULL
ORDER BY name;

selectById:
SELECT *
FROM performer
WHERE id = ?;

selectChangedSince:
SELECT *
FROM performer
WHERE updated_at > ?
ORDER BY updated_at, device_id, id;

insert:
INSERT INTO performer(id, name, notes, updated_at, deleted_at, device_id)
VALUES (?, ?, ?, ?, ?, ?);

applyMerged:
INSERT OR REPLACE INTO performer(id, name, notes, updated_at, deleted_at, device_id)
VALUES (?, ?, ?, ?, ?, ?);

update:
UPDATE performer
SET name = ?, notes = ?, updated_at = ?, device_id = ?
WHERE id = ?;

softDelete:
UPDATE performer
SET deleted_at = ?, updated_at = ?, device_id = ?
WHERE id = ?;
