-- song_instrument — junction carrying facts (decisions 41, 42). Derived id, decision 4:
--     UUIDv5(namespace('song_instrument'), song_id || '/' || instrument_id)
--
-- Facts true of a song on one instrument. Absorbs the workbook's `bass difficulty`,
-- `Guitar comments`, `BV Comments`, `C GTR` and `Wavestate Patches` columns, so
-- "how hard is this on keys" costs no schema change.
--
-- difficulty maps the workbook's a-e to 1-5 (decision 42). The range is five, not three:
-- the extract pass found `d` x31 and `e` x24 in `bass difficulty`, so a three-value
-- constraint would fail the migration on 55 rows and silently discard those cells.

CREATE TABLE song_instrument (
    id             TEXT NOT NULL PRIMARY KEY,
    song_id        TEXT NOT NULL,
    instrument_id  TEXT NOT NULL,
    difficulty     INTEGER,
    patch          TEXT,
    notes          TEXT,

    updated_at     TEXT NOT NULL,
    deleted_at     TEXT,
    device_id      TEXT NOT NULL,

    FOREIGN KEY (song_id) REFERENCES song(id),
    FOREIGN KEY (instrument_id) REFERENCES instrument(id),
    CHECK (difficulty IS NULL OR difficulty BETWEEN 1 AND 5),
    CHECK (updated_at GLOB '????-??-??T??:??:??.???Z'),
    CHECK (deleted_at IS NULL OR deleted_at GLOB '????-??-??T??:??:??.???Z')
);

CREATE UNIQUE INDEX song_instrument_pair ON song_instrument(song_id, instrument_id);
CREATE INDEX song_instrument_instrument ON song_instrument(instrument_id);

selectBySong:
SELECT
    song_instrument.id,
    song_instrument.instrument_id,
    instrument.name AS instrument_name,
    song_instrument.difficulty,
    song_instrument.patch,
    song_instrument.notes
FROM song_instrument
JOIN instrument ON instrument.id = song_instrument.instrument_id
WHERE song_instrument.song_id = ?
  AND song_instrument.deleted_at IS NULL
  AND instrument.deleted_at IS NULL
ORDER BY instrument.name;

selectBySongAndInstrument:
SELECT *
FROM song_instrument
WHERE song_id = ? AND instrument_id = ? AND deleted_at IS NULL;

selectChangedSince:
SELECT *
FROM song_instrument
WHERE updated_at > ?
ORDER BY updated_at, device_id, id;

insert:
INSERT INTO song_instrument(
    id, song_id, instrument_id, difficulty, patch, notes,
    updated_at, deleted_at, device_id
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

applyMerged:
INSERT OR REPLACE INTO song_instrument(
    id, song_id, instrument_id, difficulty, patch, notes,
    updated_at, deleted_at, device_id
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

update:
UPDATE song_instrument
SET difficulty = ?, patch = ?, notes = ?, updated_at = ?, deleted_at = ?, device_id = ?
WHERE id = ?;

softDelete:
UPDATE song_instrument
SET deleted_at = ?, updated_at = ?, device_id = ?
WHERE id = ?;
