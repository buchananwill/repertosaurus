-- practice_event — IMMUTABLE, APPEND-ONLY. Random id (UUIDv4), decisions 6, 7, 44-48.
--
-- The high-frequency table and the reason the product exists. Rows are immutable once
-- written: there is no update path and no edit UI. Deleting is an append to
-- practice_event_void, never a mutation here (decision 8) — hence created_at and
-- device_id, and deliberately no updated_at and no deleted_at (decision 9).
--
-- Ids MUST be random. Deriving them would collapse two legitimate same-day sessions into
-- one row and silently lose data (decision 6).
--
-- THERE IS NO UNIQUE CONSTRAINT ON (song_id, logged_on, instrument_id) — decision 47.
-- Working the same piece several times across a day is normal practice behaviour and
-- each pass is a substantive session in its own right. Do not add one.
--
-- logged_on defaults to today (decision 45). That default is applied in the shared core
-- from the device's *local* date, not by a SQL DEFAULT, which would be UTC and would
-- misdate a late-night session. Logging for a past date is available but demoted into a
-- menu; it is never on the primary tap path.
--
-- feel is 0-3 and optional (decision 46; schema-3 M9): a plain tap logs with feel null,
-- long-press opens the rating. Stored 1-3 values read on rating-scale RS3 unchanged.
--
-- duration_seconds (schema-3 M10): null is "logged by tap, untimed". A timer writes one new
-- event carrying it, never an update (decision 7).

CREATE TABLE practice_event (
    id               TEXT NOT NULL PRIMARY KEY,
    song_id          TEXT NOT NULL,
    logged_on        TEXT NOT NULL,
    instrument_id    TEXT NOT NULL,
    context_id       TEXT,
    feel             INTEGER,
    note             TEXT,
    duration_seconds INTEGER,

    created_at       TEXT NOT NULL,
    device_id        TEXT NOT NULL,

    FOREIGN KEY (song_id) REFERENCES song(id),
    FOREIGN KEY (instrument_id) REFERENCES instrument(id),
    FOREIGN KEY (context_id) REFERENCES practice_context(id),
    CHECK (feel IS NULL OR feel BETWEEN 0 AND 3),
    CHECK (duration_seconds IS NULL OR duration_seconds BETWEEN 1 AND 86400),
    CHECK (logged_on GLOB '????-??-??'),
    CHECK (created_at GLOB '????-??-??T??:??:??.???Z')
);

-- Staleness ordering: latest first for one song on one instrument. This is the index the
-- Session screen leans on (see song.sq selectByStaleness).
CREATE INDEX practice_event_song_instrument_logged
    ON practice_event(song_id, instrument_id, logged_on DESC);

-- Recent activity across the repertoire, and the per-instrument history view.
CREATE INDEX practice_event_instrument_logged
    ON practice_event(instrument_id, logged_on DESC);

CREATE INDEX practice_event_logged ON practice_event(logged_on DESC);

-- The primary tap path. One statement, no read first.
insert:
INSERT INTO practice_event(
    id, song_id, logged_on, instrument_id, context_id, feel, note, duration_seconds,
    created_at, device_id
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Live history for a song, voided events removed by left anti-join (decision 8).
selectBySong:
SELECT
    practice_event.id,
    practice_event.logged_on,
    practice_event.instrument_id,
    instrument.name AS instrument_name,
    practice_event.context_id,
    practice_context.name AS context_name,
    practice_event.feel,
    practice_event.note,
    practice_event.duration_seconds
FROM practice_event
LEFT JOIN practice_event_void
       ON practice_event_void.practice_event_id = practice_event.id
LEFT JOIN instrument ON instrument.id = practice_event.instrument_id
LEFT JOIN practice_context ON practice_context.id = practice_event.context_id
WHERE practice_event.song_id = ?
  AND practice_event_void.id IS NULL
ORDER BY practice_event.logged_on DESC, practice_event.created_at DESC;

-- repertoire-editing R32, R33: one song's live events AS STORED — every column a merge copy keeps
-- (created_at included), plus the instrument's name for the merge preview. Voided events are
-- excluded by the same left anti-join as selectBySong: a voided event is already out of the
-- history and is neither voided again nor copied. The instrument join is LEFT and ignores its
-- tombstone, so an event on a removed instrument is still read (and still carried).
selectLiveRowsBySong:
SELECT
    practice_event.*,
    instrument.name AS instrument_name
FROM practice_event
LEFT JOIN practice_event_void
       ON practice_event_void.practice_event_id = practice_event.id
LEFT JOIN instrument ON instrument.id = practice_event.instrument_id
WHERE practice_event.song_id = ?
  AND practice_event_void.id IS NULL
ORDER BY practice_event.logged_on DESC, practice_event.created_at DESC, practice_event.id;

-- Undo target: the newest live event this device could sensibly void.
selectMostRecentLive:
SELECT practice_event.id, practice_event.song_id, practice_event.logged_on
FROM practice_event
LEFT JOIN practice_event_void
       ON practice_event_void.practice_event_id = practice_event.id
WHERE practice_event_void.id IS NULL
ORDER BY practice_event.created_at DESC
LIMIT 1;

-- Derived counts, never stored (decision 48).
countLiveBySong:
SELECT COUNT(*)
FROM practice_event
LEFT JOIN practice_event_void
       ON practice_event_void.practice_event_id = practice_event.id
WHERE practice_event.song_id = ?
  AND practice_event_void.id IS NULL;

-- How much history hangs off one instrument. The manage-instruments screen states this
-- before it soft-deletes a row: removing an instrument hides it from the chip row, but
-- every event it carries survives and keeps counting (decisions 8, 9). The user is told
-- how much they are putting out of sight before they do it.
--
-- E39: a row is counted only when every parent is live, so an event on a soft-deleted song
-- does not count — it is already out of sight, and counting it overstates what removing the
-- instrument would hide.
countLiveByInstrument:
SELECT COUNT(*)
FROM practice_event
JOIN song ON song.id = practice_event.song_id
LEFT JOIN practice_event_void
       ON practice_event_void.practice_event_id = practice_event.id
WHERE practice_event.instrument_id = ?
  AND practice_event_void.id IS NULL
  AND song.deleted_at IS NULL;

-- scorecards SC1-SC4, SC13: live events per `logged_on` over all history; "no later than today" is
-- HabitStats's (F24 B5). SC3: deliberately NO join to `song`, unlike E39 above. A null :instrumentId
-- is every instrument.
countLiveByDay:
SELECT practice_event.logged_on, COUNT(*) AS events
FROM practice_event
LEFT JOIN practice_event_void
       ON practice_event_void.practice_event_id = practice_event.id
WHERE practice_event_void.id IS NULL
  AND (:instrumentId IS NULL OR practice_event.instrument_id = :instrumentId)
GROUP BY practice_event.logged_on
ORDER BY practice_event.logged_on;

-- Append-only tables merge by union on id (decision 11); this is the export side.
selectCreatedSince:
SELECT *
FROM practice_event
WHERE created_at > ?
ORDER BY created_at, device_id, id;

-- The import side of a union merge: an id already present is the same event.
applyMerged:
INSERT OR IGNORE INTO practice_event(
    id, song_id, logged_on, instrument_id, context_id, feel, note, duration_seconds,
    created_at, device_id
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);
