-- song — mutable record, derived id (decisions 28-40).
--
-- key_signature is the dominant diatonic signature as a signed sharp/flat count, -7..+7
-- (decision 32). tonal_centre is the home bass note as pitch class 0-11, 0 = C
-- (decision 33). There is deliberately no mode or quality column: major/minor is implied
-- by the pair (decision 35). Do not add one.
--
-- reference_recording, chord_pattern, mashup_note, tonality_note and chart_url are free
-- text on purpose (decisions 29, 30, 39) — they do not repeat, so they do not earn tables.
--
-- artist_id is NOT NULL (decision 28a). Decision 4 makes it half of the song's canonical
-- key, so a null artist yields an unstable derived id and two devices never converge.
-- Where the workbook has no artist the migration attaches the seeded `Unknown Artist` row
-- (see artist.sq); a placeholder is honest, a null FK spreads LEFT JOIN through every
-- screen.

CREATE TABLE song (
    id                   TEXT NOT NULL PRIMARY KEY,
    title                TEXT NOT NULL,
    artist_id            TEXT NOT NULL,
    reference_recording  TEXT,
    key_signature        INTEGER,
    tonal_centre         INTEGER,
    tonality_note        TEXT,
    tempo_bpm            INTEGER,
    duration_seconds     INTEGER,
    decade               INTEGER,
    loop_length          INTEGER,
    chord_count          INTEGER,
    chord_pattern        TEXT,
    groove_id            TEXT,
    mashup_note          TEXT,
    notes                TEXT,
    chart_url            TEXT,

    updated_at           TEXT NOT NULL,
    deleted_at           TEXT,
    device_id            TEXT NOT NULL,

    FOREIGN KEY (artist_id) REFERENCES artist(id),
    FOREIGN KEY (groove_id) REFERENCES groove(id),
    CHECK (key_signature IS NULL OR key_signature BETWEEN -7 AND 7),
    CHECK (tonal_centre IS NULL OR tonal_centre BETWEEN 0 AND 11),
    CHECK (updated_at GLOB '????-??-??T??:??:??.???Z'),
    CHECK (deleted_at IS NULL OR deleted_at GLOB '????-??-??T??:??:??.???Z')
);

CREATE INDEX song_artist ON song(artist_id);
CREATE INDEX song_title ON song(title);
CREATE INDEX song_groove ON song(groove_id);

-- The Session screen (decisions 8, 44, 48; views V10-V14).
--
-- Coldest first for one discipline: every eligible live song, ordered by its last practice
-- on :practiceInstrumentId, never-practised songs first. Voided events are excluded by the
-- NOT EXISTS anti-join against practice_event_void. A union merge cannot suppress a row,
-- so this anti-join is the only correct way to honour an undo (decision 8).
--
-- last_practised and times_practised are derived here, never stored (decision 48).
--
-- The anti-join sits inside the practice_event ON clause rather than in the WHERE
-- clause. In the WHERE clause it filters the *song* away once every one of its events is
-- voided, so undoing the only log for a song would drop the song out of the session list
-- altogether instead of returning it to never-practised — the opposite of decision 8.
--
-- days_since is NOT selected here. SQLDelight's SQLite dialect types
-- `julianday(a) - julianday(b)` as a non-null TEXT, and a CAST to INTEGER as a non-null
-- INTEGER, while SQLite itself yields NULL for a never-practised song — which is exactly
-- the row this ordering puts first. It is computed from last_practised in the shared
-- core instead, per decisions 48 and 57.
--
-- V10: the three filter parameters REPLACE the unfiltered form rather than sitting beside
-- it, so there is exactly one UNSCOPED staleness query in the schema and no second copy of
-- it to drift. selectByStalenessInSetlist below repeats this ORDER BY clause: it predates
-- Views, takes no filter, and is retained unfolded per views.md section 3. That is the one
-- known second copy, and it is deliberate — do not read this paragraph as saying there is
-- none.
--
-- V11: each filter component independently degrades to "no constraint" when null, so all
-- eight combinations are this one query. All three null (and :leadOnly = 0) is the
-- unfiltered case and short-circuits the EXISTS entirely, which is what makes V21's empty
-- state exactly today's behaviour.
--
-- V9: a song with NO song_performer row asserts nothing and is excluded by any performer
-- filter. Treating absent data as a match makes the filter useless on this dataset, where
-- 147 of 479 songs are unannotated.
--
-- V11a / editing E12: the EXISTS additionally joins performer and instrument and requires
-- deleted_at IS NULL on BOTH. The original form checked only song_performer.deleted_at,
-- which was harmless while NOTHING IN THE APP COULD DELETE A PERFORMER; editing.md E12
-- makes deletion reachable from the drawer, and without this a View keeps filtering on a
-- removed performer and renders its summary as "a deleted performer". This is a deliberate
-- amendment to the predicate, not a defect in it — it was written for a world where the row
-- could not go away. Both joins are inner, and both are safe as such: performer_id and
-- instrument_id are NOT NULL with foreign keys, so the only row an inner join can drop is
-- one already excluded by the deleted_at test or an orphan that violates the FK.
-- Measured on the real 479-song database, where nothing is soft-deleted: the motivating
-- View returns 231 songs / 138 never practised on guitar, unchanged by this amendment.
--
-- V12: :practiceInstrumentId and :filterInstrumentId are SEPARATE parameters, and the
-- practice instrument appears ONLY in the LEFT JOIN ... ON clause. A song that passes the
-- filter but has never been touched on the practice instrument still appears, carrying
-- last_practised IS NULL — which is the whole point of a cross-instrument View.
--
-- V12a: the sort has no performer dimension and must not grow one. practice_event carries
-- no performer, because every logged event is the owner's. Staleness is keyed on the
-- practice instrument alone; the filter is the only place a performer appears.
--
-- V14: ORDER BY last_practised IS NOT NULL ASC puts 0 before 1, so a never-practised song
-- leads. This is a stable base order only — SessionState.pending re-sorts in Kotlin via
-- SessionOrder.comparator, and HOTTEST_FIRST deliberately sorts nulls the other way. The
-- two are not redundant and neither may be deleted in favour of the other.
selectByStaleness:
SELECT
    song.id                AS song_id,
    song.title             AS title,
    artist.name            AS artist_name,
    MAX(practice_event.logged_on)   AS last_practised,
    COUNT(practice_event.id)        AS times_practised
FROM song
LEFT JOIN artist
       ON artist.id = song.artist_id
      AND artist.deleted_at IS NULL
LEFT JOIN practice_event
       ON practice_event.song_id = song.id
      AND practice_event.instrument_id = :practiceInstrumentId
      AND NOT EXISTS (
              SELECT 1 FROM practice_event_void
              WHERE practice_event_void.practice_event_id = practice_event.id
          )
WHERE song.deleted_at IS NULL
  AND ((:filterPerformerId IS NULL AND :filterInstrumentId IS NULL AND :leadOnly = 0)
       OR EXISTS (
          SELECT 1 FROM song_performer
          JOIN performer  ON performer.id  = song_performer.performer_id
          JOIN instrument ON instrument.id = song_performer.instrument_id
          WHERE song_performer.song_id = song.id
            AND song_performer.deleted_at IS NULL
            AND performer.deleted_at IS NULL
            AND instrument.deleted_at IS NULL
            AND (:filterPerformerId  IS NULL OR song_performer.performer_id  = :filterPerformerId)
            AND (:filterInstrumentId IS NULL OR song_performer.instrument_id = :filterInstrumentId)
            AND (:leadOnly = 0 OR song_performer.is_lead = 1)))
GROUP BY song.id, song.title, artist.name
ORDER BY last_practised IS NOT NULL, last_practised ASC, song.title ASC;

-- The set-list-scoped session mode.
--
-- NOT the same query as selectByStaleness scoped to a set list: this one predates Views and
-- takes none of V10's three filter parameters, so a View's eligibility filter does not reach
-- it. Folding the two together is deferred deliberately (views.md section 3) — "practise the
-- Blue Lion set" is a different session shape, and merging now would double the parameter
-- surface before either half has been used in anger. The ORDER BY is a second copy of the
-- clause above for exactly as long as that deferral stands.
selectByStalenessInSetlist:
SELECT
    song.id                AS song_id,
    song.title             AS title,
    artist.name            AS artist_name,
    MAX(practice_event.logged_on)   AS last_practised,
    COUNT(practice_event.id)        AS times_practised
FROM song
JOIN setlist_item
       ON setlist_item.song_id = song.id
      AND setlist_item.deleted_at IS NULL
JOIN setlist_set
       ON setlist_set.id = setlist_item.setlist_set_id
      AND setlist_set.deleted_at IS NULL
      AND setlist_set.setlist_id = :setlistId
LEFT JOIN artist
       ON artist.id = song.artist_id
      AND artist.deleted_at IS NULL
LEFT JOIN practice_event
       ON practice_event.song_id = song.id
      AND practice_event.instrument_id = :instrumentId
      AND NOT EXISTS (
              SELECT 1 FROM practice_event_void
              WHERE practice_event_void.practice_event_id = practice_event.id
          )
WHERE song.deleted_at IS NULL
GROUP BY song.id, song.title, artist.name
ORDER BY last_practised IS NOT NULL, last_practised ASC, song.title ASC;

selectAllLive:
SELECT *
FROM song
WHERE deleted_at IS NULL
ORDER BY title;

selectById:
SELECT *
FROM song
WHERE id = ?;

selectByArtist:
SELECT *
FROM song
WHERE artist_id = ? AND deleted_at IS NULL
ORDER BY title;

searchByTitle:
SELECT song.id, song.title, artist.name AS artist_name
FROM song
LEFT JOIN artist ON artist.id = song.artist_id
WHERE song.deleted_at IS NULL
  AND song.title LIKE '%' || :term || '%'
ORDER BY song.title;

selectChangedSince:
SELECT *
FROM song
WHERE updated_at > ?
ORDER BY updated_at, device_id, id;

insert:
INSERT INTO song(
    id, title, artist_id, reference_recording, key_signature, tonal_centre,
    tonality_note, tempo_bpm, duration_seconds, decade, loop_length, chord_count,
    chord_pattern, groove_id, mashup_note, notes, chart_url,
    updated_at, deleted_at, device_id
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

applyMerged:
INSERT OR REPLACE INTO song(
    id, title, artist_id, reference_recording, key_signature, tonal_centre,
    tonality_note, tempo_bpm, duration_seconds, decade, loop_length, chord_count,
    chord_pattern, groove_id, mashup_note, notes, chart_url,
    updated_at, deleted_at, device_id
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

update:
UPDATE song
SET title = ?,
    artist_id = ?,
    reference_recording = ?,
    key_signature = ?,
    tonal_centre = ?,
    tonality_note = ?,
    tempo_bpm = ?,
    duration_seconds = ?,
    decade = ?,
    loop_length = ?,
    chord_count = ?,
    chord_pattern = ?,
    groove_id = ?,
    mashup_note = ?,
    notes = ?,
    chart_url = ?,
    updated_at = ?,
    device_id = ?
WHERE id = ?;

softDelete:
UPDATE song
SET deleted_at = ?, updated_at = ?, device_id = ?
WHERE id = ?;
