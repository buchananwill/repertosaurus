-- artist — mutable record, derived id (decisions 20, 21).
-- Artist names are never stored as free text on a song.
--
-- Merge is last-write-wins per row on (updated_at, device_id, id) with a tombstone
-- winning a tie (decision 11). That comparison lives in the shared core; `applyMerged`
-- below is the unconditional write the core issues once it has picked the winner.

CREATE TABLE artist (
    id          TEXT NOT NULL PRIMARY KEY,
    name        TEXT NOT NULL,
    sort_name   TEXT NOT NULL,

    updated_at  TEXT NOT NULL,
    deleted_at  TEXT,
    device_id   TEXT NOT NULL,

    CHECK (updated_at GLOB '????-??-??T??:??:??.???Z'),
    CHECK (deleted_at IS NULL OR deleted_at GLOB '????-??-??T??:??:??.???Z')
);

CREATE INDEX artist_sort_name ON artist(sort_name);

-- Seed (decision 28a). `song.artist_id` is NOT NULL, so the migration attaches this row
-- wherever the workbook has no artist rather than leaving the column null.
-- The id is UUIDv5(namespace(artist), normalise('Unknown Artist')) = UUIDv5(namespace,
-- 'unknown artist'), per decisions 4/4a/4b; see ../../../../README.md.
INSERT INTO artist(id, name, sort_name, updated_at, deleted_at, device_id) VALUES
    ('cf06771d-4e8d-53fc-83fb-359be7dfaefc', 'Unknown Artist', 'Unknown Artist', '2026-08-15T00:00:00.000Z', NULL, 'seed');

selectAllLive:
SELECT *
FROM artist
WHERE deleted_at IS NULL
ORDER BY sort_name;

selectById:
SELECT *
FROM artist
WHERE id = ?;

selectChangedSince:
SELECT *
FROM artist
WHERE updated_at > ?
ORDER BY updated_at, device_id, id;

insert:
INSERT INTO artist(id, name, sort_name, updated_at, deleted_at, device_id)
VALUES (?, ?, ?, ?, ?, ?);

applyMerged:
INSERT OR REPLACE INTO artist(id, name, sort_name, updated_at, deleted_at, device_id)
VALUES (?, ?, ?, ?, ?, ?);

-- The Artists route (repertoire-editing R24): every live artist with its live song count.
-- COUNT(song.id) over a LEFT JOIN is 0 for an artist with none, and the song's tombstone is
-- tested in the ON clause, so a removed song neither counts nor drops its artist from the list.
selectAllLiveWithSongCount:
SELECT artist.id, artist.name, artist.sort_name, COUNT(song.id) AS live_songs
FROM artist
LEFT JOIN song
       ON song.artist_id = artist.id
      AND song.deleted_at IS NULL
WHERE artist.deleted_at IS NULL
GROUP BY artist.id, artist.name, artist.sort_name
ORDER BY artist.sort_name, artist.id;

-- Rename (R24). The id is never re-derived (decision 5, E21, R22).
--
-- E37 precedent: deleted_at is NOT in the SET list and `deleted_at IS NULL` IS in the WHERE,
-- so a rename that lands after a remove writes nothing.
update:
UPDATE artist
SET name = ?, sort_name = ?, updated_at = ?, device_id = ?
WHERE id = ?
  AND deleted_at IS NULL;

-- R23d: an artist already removed is not re-stamped.
softDelete:
UPDATE artist
SET deleted_at = ?, updated_at = ?, device_id = ?
WHERE id = ?
  AND deleted_at IS NULL;

-- R21 for artists: create-on-enter of a name whose derived id is a tombstone revives it.
-- Clears deleted_at and bumps updated_at and nothing else, so the stored spelling and sort
-- name survive, exactly as LookupTables' revive keeps a lookup's spelling.
restore:
UPDATE artist
SET deleted_at = NULL, updated_at = ?, device_id = ?
WHERE id = ?;
