-- Schema 2 -> 3 (schema-3 M1-M20): part_rating and suggestion_skip; practice_event's feel 0-3
-- and duration_seconds; saved_view's four triage sort names.
--
-- **Frozen once shipped. Do not edit it after that**: a later change goes in the `.sq` file and
-- the next `.sqm` (see 1.sqm's header).
--
-- M17: SQLite cannot alter a CHECK, so practice_event and saved_view are rebuilt.
-- M18: this runs with foreign keys enforced, and dropping practice_event while a void references
-- it fails — so the voids are held aside and restored.
--
-- minSdk 26 means SQLite 3.19: no DROP COLUMN, RENAME COLUMN, UPSERT or window functions.

-- M18: hold the voids aside.
CREATE TABLE practice_event_void_hold (
    id                 TEXT NOT NULL,
    practice_event_id  TEXT NOT NULL,
    created_at         TEXT NOT NULL,
    device_id          TEXT NOT NULL
);

INSERT INTO practice_event_void_hold(id, practice_event_id, created_at, device_id)
SELECT id, practice_event_id, created_at, device_id
FROM practice_event_void;

DROP TABLE practice_event_void;

-- practice_event (M9, M10, M17).
CREATE TABLE practice_event_v3 (
    id               TEXT NOT NULL PRIMARY KEY,
    song_id          TEXT NOT NULL,
    logged_on        TEXT NOT NULL,
    instrument_id    TEXT NOT NULL,
    context_id       TEXT,
    feel             INTEGER,
    note             TEXT,
    duration_seconds INTEGER,

    created_at       TEXT NOT NULL,
    device_id        TEXT NOT NULL,

    FOREIGN KEY (song_id) REFERENCES song(id),
    FOREIGN KEY (instrument_id) REFERENCES instrument(id),
    FOREIGN KEY (context_id) REFERENCES practice_context(id),
    CHECK (feel IS NULL OR feel BETWEEN 0 AND 3),
    CHECK (duration_seconds IS NULL OR duration_seconds BETWEEN 1 AND 86400),
    CHECK (logged_on GLOB '????-??-??'),
    CHECK (created_at GLOB '????-??-??T??:??:??.???Z')
);

INSERT INTO practice_event_v3(
    id, song_id, logged_on, instrument_id, context_id, feel, note, duration_seconds,
    created_at, device_id
)
SELECT
    id, song_id, logged_on, instrument_id, context_id, feel, note, NULL,
    created_at, device_id
FROM practice_event;

DROP TABLE practice_event;

ALTER TABLE practice_event_v3 RENAME TO practice_event;

CREATE INDEX practice_event_song_instrument_logged
    ON practice_event(song_id, instrument_id, logged_on DESC);

CREATE INDEX practice_event_instrument_logged
    ON practice_event(instrument_id, logged_on DESC);

CREATE INDEX practice_event_logged ON practice_event(logged_on DESC);

-- M18: practice_event_void as its .sq declares it, and the voids restored.
CREATE TABLE practice_event_void (
    id                 TEXT NOT NULL PRIMARY KEY,
    practice_event_id  TEXT NOT NULL,

    created_at         TEXT NOT NULL,
    device_id          TEXT NOT NULL,

    FOREIGN KEY (practice_event_id) REFERENCES practice_event(id),
    CHECK (created_at GLOB '????-??-??T??:??:??.???Z')
);

CREATE INDEX practice_event_void_event ON practice_event_void(practice_event_id);

INSERT INTO practice_event_void(id, practice_event_id, created_at, device_id)
SELECT id, practice_event_id, created_at, device_id
FROM practice_event_void_hold;

DROP TABLE practice_event_void_hold;

-- saved_view (M15). Nothing references it, so nothing is held aside.
CREATE TABLE saved_view_v3 (
    id                     TEXT NOT NULL PRIMARY KEY,
    name                   TEXT NOT NULL,
    filter_performer_id    TEXT,
    filter_instrument_id   TEXT,
    filter_lead_only       INTEGER NOT NULL DEFAULT 0,
    practice_instrument_id TEXT NOT NULL,
    sort_order             TEXT NOT NULL,
    position               INTEGER NOT NULL,
    notes                  TEXT,

    updated_at             TEXT NOT NULL,
    deleted_at             TEXT,
    device_id              TEXT NOT NULL,

    FOREIGN KEY (filter_performer_id)    REFERENCES performer(id),
    FOREIGN KEY (filter_instrument_id)   REFERENCES instrument(id),
    FOREIGN KEY (practice_instrument_id) REFERENCES instrument(id),
    CHECK (filter_lead_only IN (0, 1)),
    CHECK (sort_order IN (
        'COLDEST_FIRST', 'HOTTEST_FIRST',
        'TRIAGE_PRIORITY', 'TRIAGE_PRIORITY_REVERSED',
        'TRIAGE_CONFIDENCE', 'TRIAGE_CONFIDENCE_REVERSED'
    )),
    CHECK (updated_at GLOB '????-??-??T??:??:??.???Z'),
    CHECK (deleted_at IS NULL OR deleted_at GLOB '????-??-??T??:??:??.???Z')
);

INSERT INTO saved_view_v3(
    id, name, filter_performer_id, filter_instrument_id, filter_lead_only,
    practice_instrument_id, sort_order, position, notes,
    updated_at, deleted_at, device_id
)
SELECT
    id, name, filter_performer_id, filter_instrument_id, filter_lead_only,
    practice_instrument_id, sort_order, position, notes,
    updated_at, deleted_at, device_id
FROM saved_view;

DROP TABLE saved_view;

ALTER TABLE saved_view_v3 RENAME TO saved_view;

CREATE INDEX saved_view_position ON saved_view(position);

-- part_rating (M3).
CREATE TABLE part_rating (
    id            TEXT NOT NULL PRIMARY KEY,
    song_id       TEXT NOT NULL,
    performer_id  TEXT NOT NULL,
    instrument_id TEXT NOT NULL,
    kind          TEXT NOT NULL,
    level         INTEGER NOT NULL,

    updated_at    TEXT NOT NULL,
    deleted_at    TEXT,
    device_id     TEXT NOT NULL,

    FOREIGN KEY (song_id)       REFERENCES song(id),
    FOREIGN KEY (performer_id)  REFERENCES performer(id),
    FOREIGN KEY (instrument_id) REFERENCES instrument(id),
    CHECK (kind IN ('PRIORITY', 'CONFIDENCE')),
    CHECK (level BETWEEN 0 AND 3),
    CHECK (updated_at GLOB '????-??-??T??:??:??.???Z'),
    CHECK (deleted_at IS NULL OR deleted_at GLOB '????-??-??T??:??:??.???Z')
);

CREATE UNIQUE INDEX part_rating_key ON part_rating(song_id, performer_id, instrument_id, kind);
CREATE INDEX part_rating_performer_instrument ON part_rating(performer_id, instrument_id);

-- suggestion_skip (M12).
CREATE TABLE suggestion_skip (
    id            TEXT NOT NULL PRIMARY KEY,
    song_id       TEXT NOT NULL,
    performer_id  TEXT NOT NULL,
    instrument_id TEXT NOT NULL,

    created_at    TEXT NOT NULL,
    device_id     TEXT NOT NULL,

    FOREIGN KEY (song_id)       REFERENCES song(id),
    FOREIGN KEY (performer_id)  REFERENCES performer(id),
    FOREIGN KEY (instrument_id) REFERENCES instrument(id),
    CHECK (created_at GLOB '????-??-??T??:??:??.???Z')
);

CREATE INDEX suggestion_skip_part ON suggestion_skip(song_id, instrument_id, created_at);
