-- practice_context — lookup, user-extensible, derived id (decisions 15, 16, 19).
-- Why a session happened: practice, twitch, rehearsal, gig.

CREATE TABLE practice_context (
    id          TEXT NOT NULL PRIMARY KEY,
    name        TEXT NOT NULL,

    updated_at  TEXT NOT NULL,
    deleted_at  TEXT,
    device_id   TEXT NOT NULL,

    CHECK (updated_at GLOB '????-??-??T??:??:??.???Z'),
    CHECK (deleted_at IS NULL OR deleted_at GLOB '????-??-??T??:??:??.???Z')
);

CREATE INDEX practice_context_name ON practice_context(name);

-- Seed (decision 19). Ids are UUIDv5(practice_context namespace, normalised name).
INSERT INTO practice_context(id, name, updated_at, deleted_at, device_id) VALUES
    ('1a9bb75b-e61f-533f-aaae-30053e06856e', 'practice',  '2026-08-15T00:00:00.000Z', NULL, 'seed'),
    ('42cd9d7c-6ee6-5604-b2f4-81d68820212d', 'twitch',    '2026-08-15T00:00:00.000Z', NULL, 'seed'),
    ('a547e2df-0f82-5dba-a7c4-c4d0f2031208', 'rehearsal', '2026-08-15T00:00:00.000Z', NULL, 'seed'),
    ('ead21184-4281-5573-829a-5bb64a2b399c', 'gig',       '2026-08-15T00:00:00.000Z', NULL, 'seed');

selectAllLive:
SELECT *
FROM practice_context
WHERE deleted_at IS NULL
ORDER BY name;

selectById:
SELECT *
FROM practice_context
WHERE id = ?;

selectChangedSince:
SELECT *
FROM practice_context
WHERE updated_at > ?
ORDER BY updated_at, device_id, id;

-- E17: what removing this context would put out of sight — the live events logged under it.
-- Voided events are excluded by the left anti-join, exactly as countLiveByInstrument does
-- (decision 8): an undone tap is not history the user is about to lose sight of.
--
-- E19: wiring this lookup manages the VOCABULARY only. The app still cannot attach a context
-- to a logged event; that is a change on the logging path, not on a management screen.
--
-- E39: a row is counted only when every parent is live, so an event on a soft-deleted song
-- does not count — the same rule countLiveByInstrument applies, for the same reason.
countLiveEvents:
SELECT COUNT(*)
FROM practice_event
JOIN song ON song.id = practice_event.song_id
LEFT JOIN practice_event_void
       ON practice_event_void.practice_event_id = practice_event.id
WHERE practice_event.context_id = ?
  AND practice_event_void.id IS NULL
  AND song.deleted_at IS NULL;

insert:
INSERT INTO practice_context(id, name, updated_at, deleted_at, device_id)
VALUES (?, ?, ?, ?, ?);

applyMerged:
INSERT OR REPLACE INTO practice_context(id, name, updated_at, deleted_at, device_id)
VALUES (?, ?, ?, ?, ?);

update:
UPDATE practice_context
SET name = ?, updated_at = ?, device_id = ?
WHERE id = ?;

softDelete:
UPDATE practice_context
SET deleted_at = ?, updated_at = ?, device_id = ?
WHERE id = ?;
